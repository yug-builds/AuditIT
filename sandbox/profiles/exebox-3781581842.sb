
; macOS Seatbelt sandbox profile

; Sandbox profile language version, not the version of this sandbox rule set.
(version 1)

; Deny everything by default.
; For debugging, can try:
;	(allow (with report) default)
(deny default (with message "EXEBOX ID N4SZZGGIM6L3HBBDVJPYA25CAN"))

; System operations.

(allow distributed-notification-post)
(allow dynamic-code-generation)
(allow iokit-get-properties)

; Note: Other sandboxes restrict the list of iokit services.
; We allow everything for now.
(allow iokit-open)

(allow iokit-open-user-client)
(allow ipc-posix-sem)
(allow ipc-posix-shm)

; Note: Other sandboxes restrict the list of mach-lookup services.
; We allow everything for now, except com.apple.sysmond, which runs outside the
; sandbox and returns process tables and full command-line arguments (e.g. to
; pgrep -lf), bypassing same-sandbox process-info* and kern.procargs restrictions.
(allow mach-lookup)
(deny mach-lookup (global-name "com.apple.sysmond"))

; Chromium-based browsers (Google Chrome, Chrome for Testing, Chromium, and
; Electron's default bundle ID com.github.Electron; packaged Electron apps with
; custom bundle IDs are not covered) bootstrap_check_in a per-PID
; "<bundle-id>.MachPortRendezvousServer.<pid>" service at startup and abort with
; BOOTSTRAP_NOT_PRIVILEGED (1100) if it is denied. Chromium's crash handler
; (chrome_crashpad_handler) also bootstrap_check_in's an
; "org.chromium.crashpad.child_port_handshake.<...>" service and CHECK-fails if denied.
(allow mach-register
       (local-name-prefix "com.google.Chrome.MachPortRendezvousServer.")
       (global-name-prefix "com.google.Chrome.MachPortRendezvousServer.")
       (local-name-prefix "com.google.chrome.for.testing.MachPortRendezvousServer.")
       (global-name-prefix "com.google.chrome.for.testing.MachPortRendezvousServer.")
       (local-name-prefix "org.chromium.Chromium.MachPortRendezvousServer.")
       (global-name-prefix "org.chromium.Chromium.MachPortRendezvousServer.")
       (local-name-prefix "com.github.Electron.MachPortRendezvousServer.")
       (global-name-prefix "com.github.Electron.MachPortRendezvousServer.")
       (local-name-prefix "org.chromium.crashpad.child_port_handshake.")
       (global-name-prefix "org.chromium.crashpad.child_port_handshake."))

(allow mach-priv-task-port (target same-sandbox))
(allow necp-client-open)
(allow process-exec)
(allow process-fork)
(allow process-info* (target same-sandbox))
(allow signal (target same-sandbox))

; Note: Other sandboxes restrict the list of sysctls that can be read.
; We allow everything for now.
(allow sysctl-read)
; Deny reading another process's argv and envp via KERN_PROCARGS / KERN_PROCARGS2
; (e.g. via pgrep -lf or direct sysctl calls), since sysctl-read is not scoped to
; same-sandbox like process-info*. Omit (with message ...) so routine ps probes
; inside the sandbox do not surface as sandbox-blocked command errors.
(deny sysctl-read (sysctl-name-prefix "kern.procargs"))
(allow sysctl-write (sysctl-name "kern.tcsm_enable"))  ; for Node / V8
(allow system-necp-client-action)
(allow user-preference-read)

; Network - allow inbound listeners
(allow network-bind)
(allow network-inbound)
